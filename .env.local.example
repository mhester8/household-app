# Copy this file to .env.local and fill in your real values.
# Find these in your Supabase project dashboard under Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Find this at https://platform.openai.com/api-keys.
# Server-only: do NOT prefix with NEXT_PUBLIC_, and never commit the real value.
OPENAI_API_KEY=your-openai-api-key
